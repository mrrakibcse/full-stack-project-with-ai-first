    {
      "name": "Auth",
      "item": [
        {
          "name": "1. Register Patient (Custom V1)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Doe\",\n  \"email\": \"jane.patient@example.com\",\n  \"password\": \"Password123!\",\n  \"phoneNumber\": \"+1234567890\",\n  \"gender\": \"FEMALE\",\n  \"dateOfBirth\": \"1995-05-15\",\n  \"bio\": \"Patient with general consultation needs\",\n  \"patient\": {\n    \"bloodGroup\": \"A_POSITIVE\",\n    \"maritalStatus\": \"SINGLE\",\n    \"emergencyContactName\": \"John Doe\",\n    \"emergencyContactNumber\": \"+1987654321\",\n    \"address\": \"123 Healthcare Ave, Suite 4\",\n    \"medicalHistory\": \"No major illnesses\",\n    \"allergies\": \"Penicillin\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register-patient",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register-patient"]
            }
          },
          "response": []
        },
        {
          "name": "2. Sign In with Email (Better Auth)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.token) {",
                  "    pm.collectionVariables.set('token', res.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jane.patient@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/sign-in/email",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "sign-in", "email"]
            }
          },
          "response": []
        },
        {
          "name": "3. Sign Up with Email (Better Auth)",
          "request": {
            "method": "POST",
            "header": [
