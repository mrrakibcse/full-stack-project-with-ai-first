              "raw": "{{baseUrl}}/api/v1/specialties?searchTerm=&isDeleted=false",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "specialties"],
              "query": [
                {
                  "key": "searchTerm",
                  "value": "",
