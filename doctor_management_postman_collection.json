      "item": [
        {
          "name": "1. Create Specialty",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.data && res.data.id) {",
                  "    pm.collectionVariables.set('specialtyId', res.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Cardiology\",\n  \"description\": \"Cardiovascular and heart health care\",\n  \"icon\": \"https://example.com/icons/cardiology.png\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/specialties",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "specialties"]
